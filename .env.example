# --- Banco (no Railway basta adicionar o plugin MySQL e referenciar MYSQL_URL) ---
# MYSQL_URL=mysql://user:pass@host:3306/railway
DB_HOST=localhost
DB_PORT=3306
DB_NAME=moveis_db
DB_USER=root
DB_PASS=

# --- Segurança ---
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
JWT_EXPIRES_IN=2h

# --- CORS: URL do frontend na Vercel (vários separados por vírgula) ---
FRONTEND_URL=http://localhost:5500

# --- Seed (cria admin + catálogo de exemplo se o banco estiver vazio) ---
SEED_ON_BOOT=true
ADMIN_EMAIL=admin@moveis.com
ADMIN_PASSWORD=Admin@123
